// Everest Voucher EC – Prisma Schema
// Mapping với schema trong backend/src/db/init_db.sql

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

// ============= ENUMS =============
enum UserRole {
  Admin
  Customer
  Partner_Owner
  Partner_Cashier

  @@map("user_role")
}

enum AccountStatus {
  Active
  Banned

  @@map("account_status")
}

enum PartnerStatus {
  Pending
  Approved
  Rejected

  @@map("partner_status")
}

enum BannerStatus {
  Visible
  Hidden

  @@map("banner_status")
}

enum PostStatus {
  Visible
  Hidden

  @@map("post_status")
}

enum PopupStatus {
  Visible
  Hidden

  @@map("popup_status")
}

enum VoucherApprovalStatus {
  Draft
  Pending
  Approved
  Rejected

  @@map("voucher_approval_status")
}

enum VoucherDisplayStatus {
  Visible
  Hidden

  @@map("voucher_display_status")
}

enum PaymentStatus {
  Pending
  Paid
  Cancelled

  @@map("payment_status")
}

enum VoucherUsageStatus {
  Unused
  Used
  Expired
  Locked

  @@map("voucher_usage_status")
}

enum AuditActorType {
  ADMIN
  CUSTOMER
  PARTNER

  @@map("audit_actor_type")
}

enum AuditTargetType {
  USER
  PARTNER
  BRANCH
  CATEGORY
  VOUCHER
  POLICY
  BANNER
  POPUP
  POST
  ORDER
  @@map("audit_target_type")
}

// ============= TÀI KHOẢN =============
model User {
  userId       String        @id @default(uuid()) @map("user_id") @db.Uuid
  email        String        @unique @db.VarChar(100)
  phoneNumber  String?       @unique @map("phone_number") @db.VarChar(15)
  passwordHash String?       @map("password_hash") @db.VarChar(255)
  fullName     String?       @map("full_name") @db.VarChar(100)
  avatar       String?       @map("avatar") @db.VarChar(255)
  role         UserRole      @default(Customer)
  status       AccountStatus @default(Active)
  partnerId    Int?          @map("partner_id")
  emailVerified    Boolean    @default(false) @map("email_verified")
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner                 Partner?                 @relation(fields: [partnerId], references: [partnerId], onDelete: SetNull)
  branch                  Branch?                  @relation("BranchCashier")
  cartItems               CartItem[]
  orders                  Order[]
  reviews                 Review[]
  logs                    AdminAuditLog[] @relation("AuditLogs")
  feedbacks               Feedback[]
  passwordResets          PasswordReset[]
  emailOtps               EmailOtp[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  sessions                UserSession[]
  posts                   Post[]                   @relation("PostAuthor")

  @@map("users")
}

model Partner {
  partnerId              Int           @id @default(autoincrement()) @map("partner_id")
  companyName            String        @map("company_name") @db.VarChar(150)
  taxCode                String        @unique @map("tax_code") @db.VarChar(20)
  representativeName     String?       @map("representative_name") @db.VarChar(100)
  representativePosition String?       @map("representative_position") @db.VarChar(100)
  representativePhone    String?       @map("representative_phone") @db.VarChar(15)
  representativeEmail    String?       @map("representative_email") @db.VarChar(100)
  businessLicenseUrl     String?       @map("business_license_url") @db.VarChar(255)
  status                 PartnerStatus @default(Pending)
  isLocked               Boolean       @default(false) @map("is_locked")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users    User[]
  branches Branch[]
  vouchers Voucher[]

  @@map("partners")
}

model Branch {
  branchId    Int      @id @default(autoincrement()) @map("branch_id")
  partnerId   Int      @map("partner_id")
  cashierId   String?  @unique @map("cashier_id") @db.Uuid
  branchName  String   @map("branch_name") @db.VarChar(150)
  address     String   @db.VarChar(255)
  phoneNumber String   @map("phone_number") @db.VarChar(15)
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner         Partner         @relation(fields: [partnerId], references: [partnerId], onDelete: Cascade)
  cashier         User?           @relation("BranchCashier", fields: [cashierId], references: [userId], onDelete: SetNull)
  voucherBranches VoucherBranch[]
  issuedVouchers  IssuedVoucher[] @relation("IssuedAtBranch")

  @@map("branches")
}

// ============= SẢN PHẨM =============
model Category {
  categoryId   Int     @id @default(autoincrement()) @map("category_id")
  categoryName String  @map("category_name") @db.VarChar(100)
  description  String?

  vouchers Voucher[]

  @@map("categories")
}

model Banner {
  bannerId  Int          @id @default(autoincrement()) @map("banner_id")
  title     String       @db.VarChar(150)
  imageUrl  String       @map("image_url") @db.VarChar(255)
  status    BannerStatus @default(Visible)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("banners")
}

model Popup {
  popupId      Int         @id @default(autoincrement()) @map("popup_id")
  title        String      @db.VarChar(150)
  body         String      @db.VarChar(500)
  imageUrl     String?     @map("image_url") @db.VarChar(255)
  ctaLabel     String?     @map("cta_label") @db.VarChar(40)
  ctaTargetUrl String?     @map("cta_target_url") @db.VarChar(255)
  status       PopupStatus @default(Hidden)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("popups")
}

model Post {
  postId      Int        @id @default(autoincrement()) @map("post_id")
  authorId    String     @map("author_id") @db.Uuid
  title       String     @db.VarChar(200)
  content     String     @db.Text
  imageUrl    String?    @map("image_url") @db.VarChar(255)
  status      PostStatus @default(Hidden)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  author User @relation("PostAuthor", fields: [authorId], references: [userId], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@map("posts")
}

model Policy {
  policyId  Int      @id @default(autoincrement()) @map("policy_id")
  title     String   @unique @map("title") @db.VarChar(255)
  content   String   @map("content") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@map("policies")
}

model Voucher {
  voucherId            Int                   @id @default(autoincrement()) @map("voucher_id")
  partnerId            Int                   @map("partner_id")
  categoryId           Int                   @map("category_id")
  title                String                @db.VarChar(255)
  description          String?
  originalPrice        Decimal               @map("original_price") @db.Decimal(12, 2)
  salePrice            Decimal               @map("sale_price") @db.Decimal(12, 2)
  applicationCondition String?               @map("application_condition")
  totalQuantity        Int                   @map("total_quantity")
  availableQuantity    Int                   @map("available_quantity")
  imageUrl             String?               @map("image_url") @db.Text
  startDate            DateTime              @map("start_date") @db.Timestamptz
  endDate              DateTime              @map("end_date") @db.Timestamptz
  expiryDays           Int                   @map("expiry_days")
  approvalStatus       VoucherApprovalStatus @default(Draft) @map("approval_status")
  displayStatus        VoucherDisplayStatus  @default(Hidden) @map("display_status")
  isLocked             Boolean              @default(false) @map("is_locked")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner         Partner         @relation(fields: [partnerId], references: [partnerId], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict)
  voucherBranches VoucherBranch[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@map("vouchers")
}

model VoucherBranch {
  voucherId Int @map("voucher_id")
  branchId  Int @map("branch_id")

  voucher Voucher @relation(fields: [voucherId], references: [voucherId], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  @@id([voucherId, branchId])
  @@map("voucher_branches")
}

// ============= GIAO DỊCH =============
model CartItem {
  cartItemId Int      @id @default(autoincrement()) @map("cart_item_id")
  customerId String   @map("customer_id") @db.Uuid
  voucherId  Int      @map("voucher_id")
  quantity   Int
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  customer User    @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  voucher  Voucher @relation(fields: [voucherId], references: [voucherId], onDelete: Cascade)

  @@unique([customerId, voucherId])
  @@map("cart_items")
}

model Order {
  orderId       Int           @id @default(autoincrement()) @map("order_id")
  customerId    String        @map("customer_id") @db.Uuid
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String?       @map("payment_method") @db.VarChar(50)
  paymentStatus PaymentStatus @default(Pending) @map("payment_status")
  isGift        Boolean       @default(false) @map("is_gift")
  receiverEmail String?       @map("receiver_email") @db.VarChar(100)
  giftMessage   String?       @map("gift_message")
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledBy   String?       @map("cancelled_by") @db.Uuid
  cancelReason  String?       @map("cancel_reason")
  refundedAt    DateTime?     @map("refunded_at") @db.Timestamp
  refundedBy    String?       @map("refunded_by") @db.Uuid
  refundReason  String?       @map("refund_reason")
  refundAmount  Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer   User        @relation(fields: [customerId], references: [userId], onDelete: Restrict)
  orderItems OrderItem[]
  feedbacks  Feedback[]

  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  orderItemId Int     @id @default(autoincrement()) @map("order_item_id")
  orderId     Int     @map("order_id")
  voucherId   Int     @map("voucher_id")
  quantity    Int
  price       Decimal @db.Decimal(12, 2)

  order          Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  voucher        Voucher         @relation(fields: [voucherId], references: [voucherId], onDelete: Restrict)
  issuedVouchers IssuedVoucher[]

  @@map("order_items")
}

model IssuedVoucher {
  issuedVoucherId Int                @id @default(autoincrement()) @map("issued_voucher_id")
  orderItemId     Int                @map("order_item_id")
  voucherCode     String             @unique @map("voucher_code") @db.VarChar(50)
  status          VoucherUsageStatus @default(Unused)
  validFrom       DateTime           @map("valid_from") @db.Timestamptz
  validTo         DateTime           @map("valid_to") @db.Timestamptz
  usedAt          DateTime?          @map("used_at") @db.Timestamptz
  usedAtBranchId  Int?               @map("used_at_branch_id")

  orderItem    OrderItem @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)
  usedAtBranch Branch?   @relation("IssuedAtBranch", fields: [usedAtBranchId], references: [branchId], onDelete: SetNull)
  reviews      Review[]

  @@map("issued_vouchers")
}

// ============= TƯƠNG TÁC =============
model Review {
  reviewId        Int      @id @default(autoincrement()) @map("review_id")
  customerId      String   @map("customer_id") @db.Uuid
  voucherId       Int      @map("voucher_id")
  issuedVoucherId Int?     @map("issued_voucher_id")
  rating          Int
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer      User           @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  voucher       Voucher        @relation(fields: [voucherId], references: [voucherId], onDelete: Cascade)
  issuedVoucher IssuedVoucher? @relation(fields: [issuedVoucherId], references: [issuedVoucherId], onDelete: SetNull)

  @@map("reviews")
}

model Feedback {
  feedbackId  Int      @id @default(autoincrement()) @map("feedback_id")
  customerId  String?  @map("customer_id") @db.Uuid
  type        String   @map("type") @db.VarChar(50) // general | order | voucher | complaint
  subject     String   @db.VarChar(255)
  message     String   @db.Text
  email       String   @db.VarChar(100)
  phone       String?  @map("phone") @db.VarChar(15)
  orderId     Int?     @map("order_id")
  voucherCode String?  @map("voucher_code") @db.VarChar(50)
  status      String   @default("Open") @map("status") @db.VarChar(30) // Open | InProgress | Resolved | Closed
  ticketId    String   @unique @map("ticket_id") @db.VarChar(30)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer User?  @relation(fields: [customerId], references: [userId], onDelete: SetNull)
  order    Order? @relation(fields: [orderId], references: [orderId], onDelete: SetNull)

  @@map("feedbacks")
}

model PasswordReset {
  resetId   Int       @id @default(autoincrement()) @map("reset_id")
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @map("token") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("password_resets")
}

enum OtpPurpose {
  REGISTER_VERIFY
  RESET_PASSWORD
  TWO_FA_LOGIN

  @@map("otp_purpose")
}

model EmailOtp {
  otpId      Int        @id @default(autoincrement()) @map("otp_id")
  userId     String?    @map("user_id") @db.Uuid
  email      String     @map("email") @db.VarChar(100)
  codeHash   String     @map("code_hash") @db.VarChar(255)
  purpose    OtpPurpose @default(REGISTER_VERIFY)
  attempts   Int        @default(0) @map("attempts")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([email, purpose, consumedAt])
  @@map("email_otps")
}

model NotificationPreference {
  prefId    Int      @id @default(autoincrement()) @map("pref_id")
  userId    String   @unique @map("user_id") @db.Uuid
  prefs     Json     @default("{}") @map("prefs")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NotificationType {
  ORDER_PURCHASED
  ORDER_PAID
  VOUCHER_GIFT_RECEIVED
  VOUCHER_EXPIRING
  SYSTEM

  @@map("notification_type")
}

enum NotificationStatus {
  Unread
  Read

  @@map("notification_status")
}

model Notification {
  notificationId Int               @id @default(autoincrement()) @map("notification_id")
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType @default(SYSTEM) @map("type")
  title          String           @db.VarChar(255)
  message        String           @db.Text
  data           Json?            @map("data")
  status         NotificationStatus @default(Unread) @map("status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model UserSession {
  sessionId  String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceType String?   @map("device_type") @db.VarChar(50)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model AdminAuditLog {
  logId        BigInt         @id @default(autoincrement()) @map("log_id")
  actorId      String?        @map("actor_id") @db.Uuid
  actorType    AuditActorType @default(ADMIN)    @map("actor_type")
  action       String         @db.VarChar(100)               // free-form: APPROVE_PARTNER, LOGIN, ...
  targetType   AuditTargetType? @map("target_type")           // USER, VOUCHER, ORDER, ...
  targetId     String?        @map("target_id") @db.VarChar(100)
  description  String         @db.VarChar(500)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  actor        User?          @relation("AuditLogs", fields: [actorId], references: [userId], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType])
  @@index([targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}
